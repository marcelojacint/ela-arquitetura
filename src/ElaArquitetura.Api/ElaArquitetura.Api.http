@ElaArquitetura.Api_HostAddress = http://localhost:5164
# Senha da usuária (a mesma do User Secrets "UsuariaInicial:Senha"). Não versione a senha real aqui.
@senha = <sua-senha>

POST {{ElaArquitetura.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "contato.elaarquitetura@gmail.com",
  "senha": "{{senha}}"
}

###
